# Supabase (apps/web/.env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API (optional in apps/web — leave empty to use Vite proxy)
VITE_API_URL=

# Paystack public key (apps/web/.env) — test: pk_test_...
VITE_PAYSTACK_PUBLIC_KEY=

# API server (apps/api/.env)
API_PORT=3001
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack secret key (apps/api/.env ONLY — never expose to browser)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Marketplace platform fee (% of each online order kept by platform) — apps/api/.env
# Used as fallback only; super admin can set the live default in Platform → Settings.
PLATFORM_FEE_PERCENT=5

# Support contact for subscription renewal (fallback if not set in super admin dashboard)
PLATFORM_SUPPORT_EMAIL=
PLATFORM_SUPPORT_PHONE=

# AES key for encrypting shop chat message bodies at rest (apps/api/.env)
CHAT_ENCRYPTION_KEY=
